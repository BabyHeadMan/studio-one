---
// Create Film Lab Brevo signup. Keep this component on only one page.
// It uses Brevo's generated public HTML form endpoint and Cloudflare Turnstile site key.
// Do not place a Brevo API key or a Turnstile secret key in this file.
---
<link rel="stylesheet" href="https://sibforms.com/forms/end-form/build/sib-styles.css" />
<div class="sib-form" style="text-align: center;
         background-color: #EFF2F7; 
        
        
        
        ">
  <div id="sib-form-container" class="sib-form-container">
    <div id="error-message" class="sib-form-message-panel" style="font-family:Helvetica, sans-serif; font-size:16px; text-align:left; color:#661d1d; background-color:#ffeded; border-color:#ff4949; border-radius:3px;
        max-width:540px;">
      <div class="sib-form-message-panel__text sib-form-message-panel__text--center">
        <svg viewBox="0 0 512 512" class="sib-icon sib-notification__icon">
          <path d="M256 40c118.621 0 216 96.075 216 216 0 119.291-96.61 216-216 216-119.244 0-216-96.562-216-216 0-119.203 96.602-216 216-216m0-32C119.043 8 8 119.083 8 256c0 136.997 111.043 248 248 248s248-111.003 248-248C504 119.083 392.957 8 256 8zm-11.49 120h22.979c6.823 0 12.274 5.682 11.99 12.5l-7 168c-.268 6.428-5.556 11.5-11.99 11.5h-8.979c-6.433 0-11.722-5.073-11.99-11.5l-7-168c-.283-6.818 5.167-12.5 11.99-12.5zM256 340c-15.464 0-28 12.536-28 28s12.536 28 28 28 28-12.536 28-28-12.536-28-28-28z" />
        </svg>
        <span class="sib-form-message-panel__inner-text">


                Your subscription could not be saved. Please try again.
              
            
          </span>
      </div>
    </div>
    <div></div>
    <div id="success-message" class="sib-form-message-panel" style="font-family:Helvetica, sans-serif; font-size:16px; text-align:left; color:#085229; background-color:#e7faf0; border-color:#13ce66; border-radius:3px;
        max-width:540px;">
      <div class="sib-form-message-panel__text sib-form-message-panel__text--center">
        <svg viewBox="0 0 512 512" class="sib-icon sib-notification__icon">
          <path d="M256 8C119.033 8 8 119.033 8 256s111.033 248 248 248 248-111.033 248-248S392.967 8 256 8zm0 464c-118.664 0-216-96.055-216-216 0-118.663 96.055-216 216-216 118.664 0 216 96.055 216 216 0 118.663-96.055 216-216 216zm141.63-274.961L217.15 376.071c-4.705 4.667-12.303 4.637-16.97-.068l-85.878-86.572c-4.667-4.705-4.637-12.303.068-16.97l8.52-8.451c4.705-4.667 12.303-4.637 16.97.068l68.976 69.533 163.441-162.13c4.705-4.667 12.303-4.637 16.97.068l8.451 8.52c4.668 4.705 4.637 12.303-.068 16.97z" />
        </svg>
        <span class="sib-form-message-panel__inner-text">


                Almost there! Please check your inbox for a confirmation email from Create Film Lab. Click the link in that email to complete your signup.
             
            
          </span>
      </div>
    </div>
    <div></div>
    <div id="sib-container" class="sib-container--large sib-container--vertical" style="max-width:540px; text-align:center; background-color:rgba(255,255,255,1); border-width:1px; border-style:solid; border-color:#C0CCD9; border-radius:3px; direction:ltr">
      <form id="sib-form" method="POST" action="https://4e81f595.sibforms.com/serve/MUIFAMuaUH4uYpzOdX6-lsV5UW5_C4IRj3Akd0qbS_DDq0PDN84Nzh0FA4HcDw8Q6A7MMYP3GjNI7Wv0-P_1JysSpE2utvKV2yyBKRqk5y-0xHZPCbQuRCxq22IPPqrC5qutqXg-RY3YuNSz4KmdqG6DjqnYJh-q5YuY74PAtpCsheu79IvfAk6UeKUvZg9yx577tIpgJD8cKWKp4A==" data-type="subscription">


        <div style="padding: 8px 0;">


          <div class="sib-form-block" style="font-family:Helvetica, sans-serif; font-size:12px; text-align:left; color:#3C4858; background-color:transparent; text-align:left">
            <div class="sib-text-form-block">
              <p>CREATE FILM LAB — SIGNUP</p>
            </div>
          </div>



        </div>



        <div style="padding: 8px 0;">


          <div class="sib-form-block" style="font-family:Helvetica, sans-serif; font-size:32px; font-weight:700; text-align:left; color:#3C4858; background-color:transparent; text-align:left">
            <p>Join the Interest List</p>
          </div>



        </div>



        <div style="padding: 8px 0;">



          <div class="sib-input sib-form-block">
            <div class="form__entry entry_block">
              <div class="form__label-row ">


                <label class="entry__label" style="font-weight: 700; text-align: left; font-family:Helvetica, sans-serif; font-size:16px; font-weight:700; text-align:left; color:#3c4858;" for="FIRSTNAME" data-required="*">First Name</label>




                <div class="entry__field">

                  <input class="input " maxlength="200" type="text" id="FIRSTNAME" name="FIRSTNAME" autocomplete="given-name" placeholder="Your first name" data-required="true" required />

                </div>

              </div>

              <label class="entry__error entry__error--primary" style="font-family:Helvetica, sans-serif; font-size:16px; text-align:left; color:#661d1d; background-color:#ffeded; border-color:#ff4949; border-radius:3px;">
              </label>



            </div>
          </div>




        </div>



        <div style="padding: 8px 0;">



          <div class="sib-input sib-form-block">
            <div class="form__entry entry_block">
              <div class="form__label-row ">


                <label class="entry__label" style="font-weight: 700; text-align: left; font-family:Helvetica, sans-serif; font-size:16px; font-weight:700; text-align:left; color:#3c4858;" for="EMAIL" data-required="*">Email Address</label>




                <div class="entry__field">

                  <input class="input " type="email" id="EMAIL" name="EMAIL" autocomplete="email" value="" placeholder="you@example.com" data-required="true" required />

                </div>

              </div>

              <label class="entry__error entry__error--primary" style="font-family:Helvetica, sans-serif; font-size:16px; text-align:left; color:#661d1d; background-color:#ffeded; border-color:#ff4949; border-radius:3px;">
              </label>



            </div>
          </div>




        </div>



        <div style="padding: 8px 0;">




          <div class="sib-captcha sib-form-block">
            <div class="form__entry entry_block">
              <div class="form__label-row ">


                <script is:inline>
                  function handleCaptchaResponse() {
                    var event = new Event('captchaChange');
                    document.getElementById('sib-captcha').dispatchEvent(event);

                    window.grecaptcha = window.turnstile;
                  }
                </script>

                <div class="cf-turnstile g-recaptcha" data-sitekey="0x4AAAAAAF-zUcUugafdSUp7" id="sib-captcha" data-callback="handleCaptchaResponse" data-language="en"></div>
              </div>
              <label class="entry__error entry__error--primary" style="font-family:Helvetica, sans-serif; font-size:16px; text-align:left; color:#661d1d; background-color:#ffeded; border-color:#ff4949; border-radius:3px;">
              </label>



            </div>
          </div>





        </div>



        <div style="padding: 8px 0;">


          <div class="sib-optin sib-form-block" data-required="true">
            <div class="form__entry entry_mcq">
              <div class="form__label-row ">


                <label class="entry__label" style="font-weight: 700; text-align: left; font-family:Helvetica, sans-serif; font-size:16px; font-weight:700; text-align:left; color:#3c4858;" for="OPT_IN" data-required="*">Opt-in</label>





<div class="entry__choice">
  <div class="lab-checkbox-layout">
    <input
      type="checkbox"
      id="OPT_IN"
      name="OPT_IN"
      value="1"
      required
    />

    <label for="OPT_IN" class="lab-checkbox-text">
      I agree to receive Create Film Lab updates,
      educational content, and announcements from
      Baby Head Man Productions. I understand I
      can unsubscribe at any time.
    </label>
  </div>
</div>



              </div>
              <label class="entry__error entry__error--primary" style="font-family:Helvetica, sans-serif; font-size:16px; text-align:left; color:#661d1d; background-color:#ffeded; border-color:#ff4949; border-radius:3px;">
              </label>



            </div>
          </div>


        </div>



        <div style="padding: 8px 0;">


          <div class="sib-form-block" style="text-align: left">
            <button class="sib-form-block__button sib-form-block__button-with-loader" style="font-family:Helvetica, sans-serif; font-size:16px; font-weight:700; text-align:left; color:#FFFFFF; background-color:#3E4857; border-width:0px; border-radius:3px;" form="sib-form" type="submit">
              <svg class="icon clickable__icon progress-indicator__icon sib-hide-loader-icon" viewBox="0 0 512 512">
                <path d="M460.116 373.846l-20.823-12.022c-5.541-3.199-7.54-10.159-4.663-15.874 30.137-59.886 28.343-131.652-5.386-189.946-33.641-58.394-94.896-95.833-161.827-99.676C261.028 55.961 256 50.751 256 44.352V20.309c0-6.904 5.808-12.337 12.703-11.982 83.556 4.306 160.163 50.864 202.11 123.677 42.063 72.696 44.079 162.316 6.031 236.832-3.14 6.148-10.75 8.461-16.728 5.01z" />
              </svg>
              JOIN THE INTEREST LIST
            </button>


          </div>



        </div>



        <input type="text" name="email_address_check" value="" class="input--hidden">


        <input type="hidden" name="locale" value="en">


      </form>
    </div>
  </div>
</div>

<script is:inline>
  window.REQUIRED_CODE_ERROR_MESSAGE = 'Please choose a country code';
  window.LOCALE = 'en';




  window.EMAIL_INVALID_MESSAGE = window.SMS_INVALID_MESSAGE = "The information provided is invalid. Please review the field format and try again.";





  window.REQUIRED_ERROR_MESSAGE = "This field cannot be left blank. ";

  window.GENERIC_INVALID_MESSAGE = "The information provided is invalid. Please review the field format and try again.";


  window.INVALID_NUMBER = "The information provided is invalid. Please review the field format and try again.";




  window.INVALID_DATE = "Please enter a valid date";



  window.REQUIRED_MULTISELECT_MESSAGE = 'Please select at least 1 option';


  window.translation = {
    common: {
      selectedList: '{quantity} list selected',
      selectedLists: '{quantity} lists selected',
      selectedOption: '{quantity} selected',
      selectedOptions: '{quantity} selected',
    }
  };

  var AUTOHIDE = Boolean(0);
</script>



<script is:inline defer src="https://sibforms.com/forms/end-form/build/main.js"></script>



<script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>

<style is:global>

/* Scoped by unique Brevo form IDs and classes to avoid changing the rest of the site. */
.sib-form {
  background: transparent !important;
  padding: 0 !important;
  text-align: center !important;
}
#sib-form-container { max-width: 380px; margin: 0 auto; }
#sib-container {
  box-sizing: border-box !important;
  max-width: 380px !important;
  width: 100% !important;
  background: transparent !important;
  border: 0 !important;
  border-radius: 0 !important;
  padding: 0 !important;
  text-align: left !important;
}
#sib-form > div { padding: 0 0 20px !important; }
/* The main page already has the heading and introduction. */
#sib-form > div:nth-child(1),
#sib-form > div:nth-child(2) { display: none !important; }
#sib-container .entry__label {
  font-family: inherit !important;
  display: block !important;
  text-align: left !important;
  font-size: 0.85rem !important;
  font-weight: 400 !important;
  color: #dedbd5 !important;
  margin-bottom: 10px !important;
}
#sib-container .entry__field { border: 0 !important; background: transparent !important; }
#sib-container .entry__field input {
  box-sizing: border-box !important;
  width: 100% !important;
  min-height: 54px !important;
  padding: 14px 16px !important;
  border: 1px solid rgba(255,255,255,.3) !important;
  border-radius: 0 !important;
  background: transparent !important;
  color: #f0ede6 !important;
  font: inherit !important;
  font-size: .95rem !important;
  box-shadow: none !important;
}
#sib-container .entry__field input:focus { border-color: #f0ede6 !important; outline: none !important; }
#sib-container .entry__field input::placeholder { color: #77736e !important; }
#sib-container .sib-optin .entry__label { display: none !important; }
#sib-container .sib-optin .entry__choice label span:last-child,
#sib-container .sib-optin .entry__choice label p {
  font-family: inherit !important;
  font-size: .8rem !important;
  font-weight: 400 !important;
  line-height: 1.65 !important;
  color: #bcb9b3 !important;
  text-align: left !important;
  margin: 0 !important;
}
#sib-container .sib-form-block__button {
  display: inline-flex !important;
  width: auto !important;
  align-items: center !important;
  justify-content: center !important;
  padding: 17px 28px !important;
  background: transparent !important;
  color: #f0ede6 !important;
  border: 1px solid rgba(255,255,255,.5) !important;
  border-radius: 0 !important;
  font-family: inherit !important;
  font-size: .75rem !important;
  font-weight: 500 !important;
  letter-spacing: .12em !important;
  cursor: pointer !important;
  text-align: center !important;
}
#sib-container .sib-form-block__button:hover { background: #f0ede6 !important; color: #080808 !important; }
#sib-form-container .sib-form-message-panel {
  box-sizing: border-box !important;
  max-width: 380px !important;
  margin: 0 auto 20px !important;
}
#sib-container .entry__error { font-size: .8rem !important; }
#sib-container .sib-captcha { text-align: left !important; }
#sib-container .input--hidden { display:none !important; }
@media(max-width: 480px) {
  #sib-form-container, #sib-container { max-width: 100% !important; }
}


/* Remove Brevo's default checkbox indentation */

/* CREATE FILM LAB — CONSENT CHECKBOX */

#sib-container .sib-optin .entry__choice {
  padding: 0 !important;
  margin: 0 !important;
}

#sib-container .lab-checkbox-layout {
  display: grid !important;
  grid-template-columns: 22px minmax(0, 1fr) !important;
  gap: 16px !important;
  align-items: start !important;
  width: 100% !important;
}

#sib-container .lab-checkbox-layout input#OPT_IN {
  all: revert !important;
  appearance: checkbox !important;
  display: block !important;
  position: static !important;
  grid-column: 1 !important;
  width: 20px !important;
  height: 20px !important;
  margin: 2px 0 0 !important;
  padding: 0 !important;
  opacity: 1 !important;
  visibility: visible !important;
  accent-color: #f0ede6 !important;
  cursor: pointer !important;
}

#sib-container .lab-checkbox-layout .lab-checkbox-text {

  text-indent: 0 !important;
  padding-left: 0 !important;
  margin-left: 0 !important;
  all: revert !important;
  display: block !important;
  grid-column: 2 !important;
  margin: 0 !important;
  padding: 0 !important;
  width: 100% !important;
  min-width: 0 !important;
  color: #bcb9b3 !important;
  font-family: inherit !important;
  font-size: 0.8rem !important;
  line-height: 1.65 !important;
  text-align: left !important;
  cursor: pointer !important;
}


#sib-container .lab-checkbox-layout,
#sib-container .lab-checkbox-layout .lab-checkbox-text {
  text-indent: 0 !important;
}

#sib-container .lab-checkbox-layout .lab-checkbox-text::before {
  content: none !important;
}


</style>
