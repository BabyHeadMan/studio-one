---
import { Icon } from "astro-icon/components";
---

<section id="contact" class="content-section min-h-[70vh]">
  <div
    class="grid w-full items-center gap-16 lg:grid-cols-[minmax(0,1fr)_minmax(320px,0.8fr)]"
  >
    <div class="max-w-[900px]">
      <p class="eyebrow">CONTACT</p>

      <h2 class="display-lg">
        Let's create something unforgettable.
      </h2>

      <p class="section-copy my-10 max-w-[650px] leading-[1.8]">
        Whether you're interested in collaboration, development,
        or simply want to connect, we'd love to hear from you.
      </p>

<div class="mt-8">
  <a
    href="mailto:babyheadman@gmail.com"
    class="inline-block border-b border-studio-ivory/70 pb-[6px] tracking-[0.12em] transition-colors duration-200 hover:text-white"
  >
    babyheadman@gmail.com
  </a>

  <div class="mt-8 flex items-center gap-6">
    <a
      href="https://www.instagram.com/babyheadman/"
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Instagram"
      class="transition duration-200 hover:opacity-70"
    >
      <Icon name="mdi:instagram" class="h-7 w-7 text-studio-ivory transition-all duration-300 hover:scale-110 hover:text-white" />
    </a>

    <a
      href="https://www.tiktok.com/@babyheadman"
      target="_blank"
      rel="noopener noreferrer"
      aria-label="TikTok"
      class="transition duration-200 hover:opacity-70"
    >
      <Icon name="simple-icons:tiktok" class="h-7 w-7 text-studio-ivory transition-all duration-300 hover:scale-110 hover:text-white"" />
    </a>

    <a
      href="https://www.youtube.com/@babyheadmanofficial"
      target="_blank"
      rel="noopener noreferrer"
      aria-label="YouTube"
      class="transition duration-200 hover:opacity-70"
    >
      <Icon name="mdi:youtube" class="h-7 w-7 text-studio-ivory transition-all duration-300 hover:scale-110 hover:text-white" />
    </a>

    <a
      href="https://www.linkedin.com/in/brandonshoals"
      target="_blank"
      rel="noopener noreferrer"
      aria-label="LinkedIn"
      class="transition duration-200 hover:opacity-70"
    >
      <Icon name="mdi:linkedin" class="h-7 w-7 text-studio-ivory transition-all duration-300 hover:scale-110 hover:text-white" />
    </a>
  </div>
</div>
    </div>



    <div class="flex justify-center lg:justify-center">
  <img
        src="/images/portraits/brandon-shoals.png"
    alt="Brandon Shoals"
    class="w-[560px] object-contain"
  />
</div>
  </div>
</section>